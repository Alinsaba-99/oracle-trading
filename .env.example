# Oracle — secrets template. Copy to ".env" (gitignored) and fill real values.
# NEVER commit real credentials. The .env file is gitignored.

# --- Operating mode ---
# One of: research, replay, paper, shadow, evaluation, funded.
# Defaults to "research" if not set.
ORACLE_MODE=research

# --- API ---
# API authentication key.  Required for all modes except research/replay.
ORACLE_API_KEY=

# --- Mode-specific credentials ---
# Each mode uses its own env prefix to prevent accidental crossing.
# Example: PAPER mode uses ORACLE_PAPER_API_KEY, not ORACLE_FUNDED_API_KEY.

# Paper trading
ORACLE_PAPER_API_KEY=

# Shadow (requires broker)
ORACLE_SHADOW_API_KEY=
ORACLE_SHADOW_BROKER_TOKEN=

# Evaluation (requires broker)
ORACLE_EVAL_API_KEY=
ORACLE_EVAL_BROKER_TOKEN=

# Funded (requires certified broker)
ORACLE_FUNDED_API_KEY=
ORACLE_FUNDED_BROKER_TOKEN=

# --- MetaApi cloud (https://metaapi.cloud) ---
# Sign up (free tier), copy your API token from the "API access" page.
METAAPI_TOKEN=
# After provisioning your MT5 account at metaapi.cloud, copy the account id.
METAAPI_ACCOUNT_ID=

# --- MT5 demo account (MetaQuotes-Demo) ---
# Use the READ-ONLY password for data/monitoring; main password only for live orders.
MT5_LOGIN=
MT5_SERVER=MetaQuotes-Demo
MT5_PASSWORD=

# --- LLM (Modo A strategy researcher) ---
# Any OpenAI-compatible endpoint (litellm). Drives analytics/strategy/researcher.py.
LLM_BASE=https://api.vsllm.com/v1
LLM_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Data Source API Keys ---
# Polygon.io (intraday futures/stocks 1m/5m/15m)
# Free tier: 5 API calls/minute
ORACLE_DATA_POLYGON_KEY=

# AlphaAI (financial news sentiment scoring)
# Free tier: 20 req/min, 100 req/day
ORACLE_DATA_ALPHAI_KEY=

# FRED (Federal Reserve macro data)
# Optional — basic CSV access works without key
ORACLE_DATA_FRED_KEY=
