def check_file_exists(relative: str) -> bool:
    return (ROOT / relative).exists()


def check_config_exists(relative: str) -> bool:
    """Check pyproject.toml for certain config."""
    if relative == "ruff check":
        pyproject = ROOT / "pyproject.toml"
        if pyproject.exists():
            return "[tool.ruff]" in pyproject.read_text()
    if relative == "mypy strict":
        pyproject = ROOT / "pyproject.toml"
        if pyproject.exists():
            return "strict = true" in pyproject.read_text()
    if relative == "pytest config":
        pyproject = ROOT / "pyproject.toml"
        if pyproject.exists():
            return "[tool.pytest.ini_options]" in pyproject.read_text()
    return False


def check_code_exists(keyword: str, context: str = "") -> list[str]:
    """Search for keyword in Python source files."""
    findings = []
    for f in sorted(ROOT.rglob("*.py")):
        if any(skip in f.parts for skip in SKIP_DIRS):
            continue
        try:
            text = f.read_text()
            if keyword.lower() in text.lower():
                rel = str(f.relative_to(ROOT))
                findings.append(rel)
        except Exception:
            pass
    return findings


def main():
    target_gate = None
    if "--gate" in sys.argv:
        idx = sys.argv.index("--gate")
        if idx + 1 < len(sys.argv):
            target_gate = sys.argv[idx + 1].upper()

    full = "--full" in sys.argv

    gates_to_check = [target_gate] if target_gate else list(GATES.keys())

    for gate_id in gates_to_check:
        if gate_id not in GATES:
            print(f"Gate sconosciuto: {gate_id}")
            continue

        gate = GATES[gate_id]
        print(f"\n{'=' * 70}")
        print(f"{gate_id}: {gate['title']}")
        print(f"{'=' * 70}")

        passed = 0
        total = 0
        for keyword, label, check_type in gate["checks"]:
            total += 1
            if check_type == "file":
                found = check_file_exists(keyword)
            elif check_type == "config":
                found = check_config_exists(keyword)
            elif check_type == "code":
                findings = check_code_exists(keyword)
                found = len(findings) > 0
            else:
                found = False

            status = "✓" if found else "✗"
            if found:
                passed += 1

            if check_type == "code" and found and full:
                findings = check_code_exists(keyword)
                print(f"  {status} {label:<50} ({len(findings)} refs)")
                for fi in findings[:3]:
                    print(f"       {fi}")
                if len(findings) > 3:
                    print(f"       ... e altri {len(findings) - 3}")
            else:
                print(f"  {status} {label:<60}")

        pct = (passed / total * 100) if total > 0 else 0
        verdict = "PASS" if passed == total else "INCOMPLETE"
        print(f"\n  {verdict}: {passed}/{total} checks ({pct:.0f}%)")


if __name__ == "__main__":
    main()
