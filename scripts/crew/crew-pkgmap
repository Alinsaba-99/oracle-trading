#!/usr/bin/env python3
"""crew-pkgmap — Mappa struttura package Python del progetto Oracle.

Output: per ogni package, elenco moduli, __init__.py exports, file count.
"""

from __future__ import annotations

import ast
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
SKIP_DIRS = {
    ".git",
    "__pycache__",
    "node_modules",
    ".venv",
    ".lint_venv",
    "oracle.egg-info",
    ".mypy_cache",
    ".ruff_cache",
    ".pytest_cache",
    ".omx",
    ".omc",
    ".omo",
    ".bg-shell",
}
SOURCE_SUBDIRS = [
    "core",
    "market",
    "analytics",
    "execution",
    "genetics",
    "research",
    "agents",
    "audit",
    "policy",
    "orchestration",
    "apps",
    "plugins",
]


def is_package_dir(d: Path) -> bool:
    return d.is_dir() and d.name not in SKIP_DIRS and not d.name.startswith(".")


def extract_init_exports(path: Path) -> list[str]:
    """Parse __all__ from an __init__.py."""
    try:
        tree = ast.parse(path.read_text())
        for node in ast.walk(tree):
            if isinstance(node, ast.Assign):
                for target in node.targets:
                    if isinstance(target, ast.Name) and target.id == "__all__":
                        if isinstance(node.value, ast.List):
                            return [
                                el.value for el in node.value.elts if isinstance(el, ast.Constant)
                            ]
    except Exception:
        return []
    return []


def walk_packages(base: Path, prefix: str = "") -> list[dict]:
    """Recursively list packages and their .py files."""
    entries = []
    for child in sorted(base.iterdir()):
        if not is_package_dir(child):
            continue
        pkg_name = f"{prefix}.{child.name}" if prefix else child.name
        py_files = sorted(child.glob("*.py"))
        sub_packages = [
            d for d in child.iterdir() if is_package_dir(d) and (d / "__init__.py").exists()
        ]

        init_file = child / "__init__.py"
        exports = extract_init_exports(init_file) if init_file.exists() else []

        entries.append(
            {
                "package": pkg_name,
                "path": str(child.relative_to(ROOT)),
                "modules": [f.name for f in py_files if f.name != "__init__.py"],
                "exports": exports,
                "has_init": init_file.exists(),
                "sub_count": len(sub_packages),
            }
        )
        for sub in walk_packages(child, pkg_name):
            entries.append(sub)
    return entries


def main():
    packages = []
    for sd in SOURCE_SUBDIRS:
        sp = ROOT / sd
        if sp.exists():
            packages.extend(walk_packages(sp))

    # Print overview
    print(f"=== Package Map — {ROOT.name} ===\n")
    print(f"{'Package':<40} {'#mods':>6} {'#exports':>9} {'__init__':>8} {'Subpkgs':>8}")
    print("-" * 75)
    for p in sorted(packages, key=lambda x: x["package"]):
        if not p["has_init"]:
            continue
        print(
            f"{p['package']:<40} {len(p['modules']):>6} {len(p['exports']):>9} {'yes' if p['has_init'] else 'no':>8} {p['sub_count']:>8}"
        )

    print(f"\n{'=' * 75}")
    print(f"Totale package con __init__: {sum(1 for p in packages if p['has_init'])}")
    print(f"Totale moduli Python: {sum(len(p['modules']) for p in packages)}")

    # Per-package detail
    print("\n\n=== Dettaglio per Package ===\n")
    for p in sorted(packages, key=lambda x: x["package"]):
        print(f"\n--- {p['package']} ({p['path']}) ---")
        if p["exports"]:
            for exp in p["exports"]:
                print(f"  export: {exp}")
        if p["modules"]:
            for mod in sorted(p["modules"]):
                print(f"  module: {mod}")


if __name__ == "__main__":
    main()
